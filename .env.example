# Copiar a .env. Ninguna clave secreta va aquí ni en el bundle.
VITE_API_BASE_URL=https://lumon-api.vercel.app/api/v1
VITE_WS_BASE_URL=wss://lumon-api.vercel.app/api/v1

# Supabase Storage. Bucket público lumon-media, solo image/webp, máximo 300 KB.
# anon inserta únicamente en la carpeta del TEAM_CODE. Nunca la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo si en vez de Supabase se usa Cloudinary (preset unsigned, sin API secret).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
